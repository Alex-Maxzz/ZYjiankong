// TaskbarStudio application icon resource
// ID 1 is the application's main icon (used by Explorer, taskbar, etc.)
#include <windows.h>

1 ICON "app.ico"

// PawnIO RyzenSMU blob (AMD PM Table 读取，嵌入 EXE 免外部文件)
200 BLOB "RyzenSMU.bin"

// 应用清单：请求管理员权限（PawnIO 驱动需要 admin）+ Per-Monitor DPI
1 24 "app.manifest"
